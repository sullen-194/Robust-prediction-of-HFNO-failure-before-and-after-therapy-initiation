# ---------------------------------------------------------------------------
# MIMIC-IV and the Dutch Data Warehouse are credentialed datasets governed by a
# PhysioNet data use agreement and by the DDW consortium. Individual-level data
# derived from them must NOT be committed. These rules are deliberately broad.
# ---------------------------------------------------------------------------
filtered_data/
processed_data/
ddw_export/
ddw_models_old/
ddw_validation_original/

# This repository holds code only. Analysis outputs are reported in the paper and
# are not redistributed here - including aggregate ones, since the DDW outputs are
# consortium-governed and cannot be regenerated by any code in this repository.
results/
*.tiff

# Manuscript, figures and tables are not distributed with the code
Manuscript/

# Local database credentials
.env
*.pgpass

# ---------------------------------------------------------------------------
# Notebook outputs embed dataframe dumps, including shifted admission
# timestamps and local filesystem paths. Clear them before committing:
#     jupyter nbconvert --clear-output --inplace *.ipynb
# ---------------------------------------------------------------------------
.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
Thumbs.db
